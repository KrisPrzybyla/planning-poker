# Planning Poker Environment Configuration

# Server Configuration
NODE_ENV=production
PORT=3000
# CORS origin allowed in production (set to your domain, or leave unset to disable CORS)
# CORS_ORIGIN=https://your-domain.com

# Reverse proxy support (set to true if behind proxy/CDN like Nginx, Cloudflare, etc.)
# TRUST_PROXY=true

# Room state storage (required). Rooms/votes live in Redis so a server
# restart or redeploy no longer wipes every active session. Include a
# password if the instance requires one, and consider a dedicated db index
# (the /1 below) if this Redis is shared with other services.
# REDIS_URL=redis://:password@localhost:6379/1

# API rate limiting (window in ms and max requests per window). Defaults: 60000 ms, 180 requests
# API_RATE_WINDOW_MS=60000
# API_RATE_MAX=180

# Frontend (optional): override backend URL in frontend builds/tests
# VITE_BACKEND_URL=http://localhost:3000